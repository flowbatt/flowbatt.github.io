---
import { paperReferences } from '../data/paperContent';
import { resources } from '../data/content';

interface Props { text: string; }
const { text } = Astro.props;
const links: Record<string, { href: string; title?: string }> = {
  'table 1': { href: '#soh-results-table' },
  'appendix A.5': { href: `${resources.paper.replace('/abs/', '/pdf/')}#page=20`, title: 'Additional SOH results in the paper' },
  'appendix A.5.3': { href: `${resources.paper.replace('/abs/', '/pdf/')}#page=22`, title: 'Cycle-wise SOH prediction in the paper' },
  ...Object.fromEntries(paperReferences.map(reference => [`[${reference.number}]`, { href: reference.href, title: reference.title }])),
};
const parts = text.split(/(table 1|appendix A\.5(?:\.3)?|\[(?:51|52)\])/g);
---
{parts.map(part => links[part] ? <a href={links[part].href} title={links[part].title}>{part}</a> : part)}
